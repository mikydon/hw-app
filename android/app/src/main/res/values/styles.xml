<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 1.5.0 (Michael: nothing grey that isn't the app): Android's own bits inside the app (text cursor and
         selection handles, any dialog the WebView opens) use the app's yellow and dark navy, never the default teal/grey. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0E1B36</item>
        <item name="colorPrimaryDark">#0E1B36</item>
        <item name="colorAccent">#A78BFA</item>
        <item name="colorControlActivated">#A78BFA</item>
        <item name="android:textColorHighlight">#66A78BFA</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Launch screen: Android 12+ shows the icon on the app colour; older versions show drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>