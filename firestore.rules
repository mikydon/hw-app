rules_version = '2';
// HW App (1.7.0): who may read and write what. Paste into Firebase console → Firestore → Rules → Publish.
// Tested in CI against the Firestore emulator (.github/rules-test). Anything not allowed here is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(id) { return signedIn() && request.auth.uid == id; }
    function data() { return request.resource.data; }
    function only(keys) { return data().keys().hasOnly(keys); }
    function nowTs() { return data().ts == request.time; }
    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function nickOk(n) { return n is string && n.matches('^[\\p{L}\\p{N}_.-]{3,20}$'); }
    function pfpOk(p) { return p == null || (p is string && p.size() < 24000 && p.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')); }
    function statsOk() {
      return nickOk(data().nick) && pfpOk(data().get('pfp', null))
        && intIn(data().xp, 0, 100000000) && intIn(data().lvl, 1, 100000)
        && intIn(data().streak, 0, 100000) && intIn(data().n, 0, 100000) && nowTs();
    }
    function codeOk(c) { return c is string && c.matches('^[A-HJ-NP-Z2-9]{6}$'); }

    // Profiles: anyone signed in can open one (friends, requests); nobody can list them all.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow create, update: if isMe(uid)
        && only(['nick', 'pfp', 'xp', 'lvl', 'streak', 'n', 'code', 'global', 'ts'])
        && statsOk() && codeOk(data().code) && data().global is bool
        && existsAfter(/databases/$(database)/documents/codes/$(data().code))
        && getAfter(/databases/$(database)/documents/codes/$(data().code)).data.uid == uid;
      allow delete: if isMe(uid);
    }
    // World leaderboard: only people who switched it on; read in pages of at most 100.
    match /board/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow create, update: if isMe(uid) && only(['nick', 'pfp', 'xp', 'lvl', 'streak', 'n', 'ts']) && statsOk();
      allow delete: if isMe(uid);
    }
    // Profile cards (1.7.0, like a Steam profile): level, streaks, workouts, reps, time, badge tiers and exercise ranks.
    // vis = who may open it: 'friends' (default), 'all' (anyone signed in) or 'none' (only you). People you blocked
    // (blocks/{uid}) never can. A card is written in parts (stats, or only vis), so every field is optional.
    function cardOk() {
      return only(['vis', 'lvl', 'xp', 'streak', 'best', 'n', 'reps', 'min', 'since', 'ach', 'rk', 'ts'])
        && data().get('vis', 'friends') in ['friends', 'all', 'none']
        && intIn(data().get('lvl', 1), 1, 100000) && intIn(data().get('xp', 0), 0, 100000000)
        && intIn(data().get('streak', 0), 0, 100000) && intIn(data().get('best', 0), 0, 100000)
        && intIn(data().get('n', 0), 0, 100000) && intIn(data().get('reps', 0), 0, 100000000)
        && intIn(data().get('min', 0), 0, 10000000)
        && (data().get('since', null) == null || (data().since is string && data().since.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && data().get('ach', {}) is map && data().get('ach', {}).size() <= 40
        && data().get('rk', {}) is map && data().get('rk', {}).size() <= 40
        && nowTs();
    }
    function notBlockedBy(owner) {
      return !exists(/databases/$(database)/documents/blocks/$(owner))
        || !(request.auth.uid in get(/databases/$(database)/documents/blocks/$(owner)).data.b);
    }
    function cardOpen(owner) {
      let v = resource.data.get('vis', 'friends');
      return signedIn() && notBlockedBy(owner) && (v == 'all'
        || (v == 'friends' && exists(/databases/$(database)/documents/friends/$(owner)/list/$(request.auth.uid))));
    }
    match /cards/{uid} {
      allow get: if isMe(uid) || cardOpen(uid);
      allow create, update: if isMe(uid) && cardOk();
      allow delete: if isMe(uid);
    }
    // Who you blocked (1.7.0): only you read it; the rules above use it to keep them off your profile card.
    match /blocks/{uid} {
      allow get, delete: if isMe(uid);
      allow create, update: if isMe(uid) && only(['b', 'ts']) && data().b is list && data().b.size() <= 500 && nowTs();
    }
    // Unique nicknames and friend codes: one owner each, never taken over (deleting one that isn't there is harmless,
    // so deleting an account still works when this phone remembers an old nickname).
    match /nicks/{nick} {
      allow get: if signedIn();
      allow create: if signedIn() && only(['uid']) && data().uid == request.auth.uid && nickOk(nick) && nick == nick.lower();
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && only(['uid']) && data().uid == request.auth.uid && codeOk(code);
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }
    // Friend requests: the sender creates one in the receiver's inbox; either of them can remove it.
    match /inbox/{to}/from/{from} {
      allow create: if isMe(from) && to != from && only(['ts']) && nowTs();
      allow get: if isMe(to) || isMe(from);
      allow list: if isMe(to);
      allow delete: if isMe(to) || isMe(from);
    }
    // Friends: written for both people when the receiver accepts (the request must exist);
    // either friend can end it.
    match /friends/{owner}/list/{other} {
      allow read: if isMe(owner);
      allow create: if only(['ts']) && nowTs() && (
        (isMe(owner) && exists(/databases/$(database)/documents/inbox/$(owner)/from/$(other))) ||
        (isMe(other) && exists(/databases/$(database)/documents/inbox/$(other)/from/$(owner))));
      allow delete: if isMe(owner) || isMe(other);
    }
    // The automatic cloud backup: only its owner.
    match /backups/{uid} {
      allow get, delete: if isMe(uid);
      allow create, update: if isMe(uid) && only(['json', 'n', 'ts']) && data().json is string
        && data().json.size() < 900000 && intIn(data().n, 0, 100000) && nowTs();
    }
    // Chats (1.5.0): only the two people in the chat id (their uids, sorted, joined by "_") can read it;
    // writing needs them to be friends right now. Either of them can delete (account deletion).
    function members(cid) { return cid.split('_'); }
    function inChat(cid) { return signedIn() && members(cid).size() == 2 && request.auth.uid in members(cid); }
    function otherIn(cid) { return members(cid)[0] == request.auth.uid ? members(cid)[1] : members(cid)[0]; }
    function friendsWith(o) { return exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(o)); }
    function textOk(t, max) { return t is string && t.size() >= 1 && t.size() <= max; }
    // 1.5.2: th = the chat's colour, set by either of them (one of the app's colours); "last" is only written with a
    // new message by its sender (a chat may exist with just a colour).
    function themeOk(t) { return t in ['y', 'mint', 'sky', 'pink', 'violet', 'orange', 'red', 'white', 'lime', 'teal', 'coral', 'indigo', 'rose', 'grey',
      'sunset', 'ocean', 'aurora', 'insta', 'berry', 'night', 'fire', 'candy', 'forest', 'mono', 'peach', 'galaxy']; }
    function lastOk() { return data().last.keys().hasOnly(['from', 'text', 'ts']) && data().last.from == request.auth.uid
        && textOk(data().last.text, 120) && data().last.ts == request.time; }
    match /chats/{cid} {
      allow get, delete: if inChat(cid);
      allow list: if signedIn() && request.auth.uid in resource.data.m;
      allow create: if inChat(cid) && friendsWith(otherIn(cid)) && only(['m', 'last', 'th'])
        && data().m == members(cid) && members(cid)[0] < members(cid)[1]
        && (!('last' in data()) || lastOk()) && (!('th' in data()) || themeOk(data().th));
      allow update: if inChat(cid) && friendsWith(otherIn(cid)) && only(['m', 'last', 'th'])
        && data().m == resource.data.m
        && (data().get('last', null) == resource.data.get('last', null) || lastOk())
        // (an older app, 1.5.1, rewrites the chat without the colour when it sends: allowed, the colour just resets)
        && (data().get('th', null) == resource.data.get('th', null) || !('th' in data()) || themeOk(data().th));
      // 1.5.2: a reply carries a short copy of the message it answers (re); the sender can edit the text of their own
      // message for 15 minutes (ed = when), nothing else changes.
      function reOk(r) { return r is map && r.keys().hasOnly(['id', 'from', 'text']) && r.id is string && r.id.size() <= 40
        && r.from is string && r.from.size() <= 128 && r.text is string && r.text.size() <= 120; }
      match /msgs/{mid} {
        allow read, delete: if inChat(cid);
        allow create: if inChat(cid) && friendsWith(otherIn(cid)) && only(['from', 'text', 'ts', 're'])
          && data().from == request.auth.uid && textOk(data().text, 1000) && nowTs()
          && (!('re' in data()) || reOk(data().re));
        // either: the sender edits the text (15 min), or anyone in the chat sets/removes only their own reaction
        allow update: if inChat(cid) && friendsWith(otherIn(cid)) && (
          (resource.data.from == request.auth.uid
            && data().diff(resource.data).affectedKeys().hasOnly(['text', 'ed'])
            && textOk(data().text, 1000) && data().ed == request.time
            && request.time < resource.data.ts + duration.value(15, 'm'))
          || (data().diff(resource.data).affectedKeys().hasOnly(['rx']) && data().rx is map
            && data().rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in data().rx)
              || (data().rx[request.auth.uid] is string && data().rx[request.auth.uid].size() >= 1 && data().rx[request.auth.uid].size() <= 16))));
      }
    }
    // Phone notifications (1.6.0): the FCM tokens of your phones, your language, on/off and who you blocked. Only you
    // read or write it; the push server (worker/) reads it with the service account, which rules don't limit.
    match /push/{uid} {
      allow get, delete: if isMe(uid);
      allow create, update: if isMe(uid) && only(['t', 'lang', 'off', 'blk', 'ts'])
        && data().get('t', []) is list && data().get('t', []).size() <= 5
        && data().lang is string && data().lang.size() <= 5 && data().off is bool
        && data().blk is list && data().blk.size() <= 500 && nowTs();
    }
    // Reports about a profile: anyone signed in can send one; only the developer reads them (console).
    match /reports/{id} {
      allow create: if signedIn() && only(['by', 'about', 'reason', 'ts']) && data().by == request.auth.uid
        && data().about is string && data().reason is string && data().reason.size() <= 300 && nowTs();
    }
  }
}
